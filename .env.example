# ==============================================================================
# VYBE Media Platform — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development, or add these variables in
# your production hosting dashboard (e.g., Vercel Project Settings > Environment Variables).
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit real production secrets, API keys, or passwords to git.
# 2. In production, NEXTAUTH_SECRET must be at least 32 characters (generate with openssl).
# 3. In production, NEXTAUTH_URL and NEXT_PUBLIC_SITE_URL must use https://.
# ==============================================================================
#
# ==============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ==============================================================================
# [ ] DATABASE_URL (REQUIRED): Managed PostgreSQL URI (e.g. Supabase, Neon, AWS RDS).
#     Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true
# [ ] DIRECT_DATABASE_URL (REQUIRED if connection pooling used): Direct PostgreSQL URI.
#     Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# [ ] NEXTAUTH_URL (REQUIRED): Canonical HTTPS production domain.
#     Format: https://<YOUR-PRODUCTION-DOMAIN> (do NOT use http:// or localhost in prod)
# [ ] NEXT_PUBLIC_SITE_URL (REQUIRED): Public URL for SEO canonicals, sitemap & RSS feeds.
#     Format: https://<YOUR-PRODUCTION-DOMAIN>
# [ ] NEXTAUTH_SECRET / AUTH_SECRET (REQUIRED): High-entropy random secret (>= 32 chars).
#     Generate using: openssl rand -base64 32
# [ ] COOKIE_SECURE (REQUIRED in prod): Set to "true" to enforce __Secure- cookie flags.
# [ ] AI_PROVIDER_API_KEY (OPTIONAL): Gemini or OpenAI API key for AI draft generation.
#     If omitted, draft generation fails honestly with HTTP 503 (AiConfigurationError).
# [ ] GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET (OPTIONAL): Google OAuth 2.0 credentials.
#     If omitted, "Continue with Google" remains safely disabled in UI.
# [ ] RESEND_API_KEY / NEWSLETTER_API_KEY (OPTIONAL): Outbound transactional email key.
#     If omitted, newsletter confirmation & password reset tokens are stored/stubbed.
# [ ] UPSTASH_REDIS_REST_URL & UPSTASH_REDIS_REST_TOKEN (OPTIONAL): Distributed rate limiter.
#     If omitted, platform falls back to in-memory sliding window bucket store.
# ==============================================================================

# --- Public Brand & Site Metadata ---
NEXT_PUBLIC_SITE_NAME="VYBE"
# In local dev: http://localhost:3000
# In production: https://<YOUR-PRODUCTION-DOMAIN> (placeholder — set your actual registered domain)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_DESCRIPTION="TODO: Official tagline pending — International music & celebrity news media platform."

# --- Database Configuration ---
# Local Dev:  SQLite database file
# Production: Managed PostgreSQL connection string (Supabase, Neon, etc.)
# Note: For production, prisma/schema.prisma datasource provider must also be changed to "postgresql".
DATABASE_URL="file:./dev.db"
DIRECT_DATABASE_URL=""

# --- Authentication & Sessions (Auth.js / NextAuth v4) ---
# In production, NEXTAUTH_SECRET MUST be generated and at least 32 characters long.
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-generated-random-secret-in-local-env"
NEXTAUTH_SECRET="replace-with-generated-random-secret-in-local-env"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Set to "true" in production to enforce Secure; SameSite=Lax; HttpOnly session cookies
COOKIE_SECURE="false"

# --- Google OAuth 2.0 (Optional) ---
# Create credentials in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: https://<YOUR-PRODUCTION-DOMAIN>/api/auth/callback/google
# If left empty, Google login is disabled in the UI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Outbound Email Delivery (Optional) ---
# Transactional provider key (e.g., Resend, SendGrid, Postmark, AWS SES)
# Used for newsletter double-opt-in emails and password reset links.
# If left empty, tokens are hashed/persisted but outbound delivery is stubbed.
RESEND_API_KEY=""
NEWSLETTER_API_KEY="your-newsletter-provider-key-placeholder"
EMAIL_FROM="noreply@<YOUR-PRODUCTION-DOMAIN>"

# --- AI Content Engine (Human-Gated Pipeline) ---
AI_PROVIDER="gemini"
AI_MODEL_NAME="gemini-2.5-flash"
AI_PROVIDER_API_KEY=""

# Hard guardrail 1: Shipped default is "false". AI drafts NEVER auto-publish without review.
AI_AUTO_PUBLISH="false"
# Hard guardrail 2: Shipped default is "false". Secondary administrative kill-switch.
AI_AUTO_PUBLISH_ENABLED_BY_ADMIN="false"

# --- Distributed Rate Limiting (Optional: Upstash Redis REST) ---
# By default, rate limiting runs in-memory per Node.js process (10 req/min content, 6 req/min auth).
# For horizontally scaled serverless instances, provide Upstash Redis REST credentials:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Media Object Storage (Optional: AWS S3 / Cloudflare R2) ---
STORAGE_ENDPOINT="https://example-storage-endpoint.invalid"
STORAGE_BUCKET_NAME="vybe-media-assets-placeholder"
STORAGE_ACCESS_KEY_ID="your-storage-access-key-id-placeholder"
STORAGE_SECRET_ACCESS_KEY="your-storage-secret-access-key-placeholder"

# --- Cron Job Authentication (Optional) ---
# Shared secret for authenticating manual/scheduled scanning triggers
CRON_SECRET="your-cron-verification-secret-placeholder"
